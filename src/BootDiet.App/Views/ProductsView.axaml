<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BootDiet.App.ViewModels"
             x:Class="BootDiet.App.Views.ProductsView"
             x:DataType="vm:ProductListViewModel">
  <!-- S2 제품 목록 + S3 상세. 디자인 v05(Products_v05): 줄마다 이름·배지·선택만, 상세는 한 줄 설명 + 세그먼트. -->
  <UserControl.Styles>
    <Style Selector="Border.dot"><Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" /><Setter Property="CornerRadius" Value="3" /></Style>
    <Style Selector="Border.remove"><Setter Property="Background" Value="{DynamicResource VerdictRemove}" /></Style>
    <Style Selector="Border.disable"><Setter Property="Background" Value="{DynamicResource VerdictDisable}" /></Style>
    <Style Selector="Border.banking"><Setter Property="Background" Value="{DynamicResource VerdictBanking}" /></Style>
    <Style Selector="Border.review"><Setter Property="Background" Value="{DynamicResource VerdictReview}" /></Style>
    <Style Selector="Border.keep"><Setter Property="Background" Value="{DynamicResource VerdictKeep}" /></Style>
    <Style Selector="ToggleButton.group">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="16,18,16,10" />
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="ToggleButton.group:checked /template/ ContentPresenter, ToggleButton.group:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="ListBox.segment.tight > ListBoxItem"><Setter Property="Padding" Value="8,0" /></Style>
    <Style Selector="ToggleButton.linktoggle">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="ToggleButton.linktoggle:checked /template/ ContentPresenter, ToggleButton.linktoggle:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <Grid ColumnDefinitions="*,420">
      <!-- 목록 -->
      <DockPanel Margin="56,48,28,24">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,28">
          <TextBlock Text="제품" Classes="h1" FontSize="30" VerticalAlignment="Center" />
          <ComboBox Grid.Column="2" Classes="pill" Width="150" MinHeight="42" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,10,0" />
          <TextBox Grid.Column="3" Width="220" MinHeight="42" CornerRadius="999" Padding="18,0" VerticalContentAlignment="Center"
                   Watermark="찾기" Text="{Binding SearchText}" />
        </Grid>

        <Border Classes="card" Padding="12,12,12,16">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProductGroupViewModel">
                  <StackPanel IsVisible="{Binding IsVisible}">
                    <ToggleButton Classes="group" IsChecked="{Binding IsExpanded}">
                      <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto">
                        <Border Classes="dot" VerticalAlignment="Center" Margin="0,0,10,0"
                                Classes.remove="{Binding IsRemove}" Classes.disable="{Binding IsDisable}"
                                Classes.banking="{Binding IsBanking}" Classes.review="{Binding IsReview}" Classes.keep="{Binding IsKeep}" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Bold" FontSize="15" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Classes="muted" FontSize="14" />
                        <TextBlock Grid.Column="4" Text="펼치기" IsVisible="{Binding !IsExpanded}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentText}" />
                      </Grid>
                    </ToggleButton>
                    <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProductItemViewModel">
                          <Button Classes="row" Classes.selected="{Binding IsSelected}" Classes.changed="{Binding DiffersFromRecommendation}"
                                  Command="{Binding $parent[UserControl].((vm:ProductListViewModel)DataContext).SelectCommand}"
                                  CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="*,Auto,110">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,14,0"
                                         ToolTip.Tip="{Binding Reason}" />
                              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border Classes="badge ai" IsVisible="{Binding IsAiVerdict}">
                                  <TextBlock Text="AI" />
                                </Border>
                                <Border Classes="badge warn" IsVisible="{Binding HasRiskBadge}" ToolTip.Tip="{Binding RiskTitle}">
                                  <TextBlock Text="{Binding RiskBadge}" />
                                </Border>
                                <Border Classes="badge warn" IsVisible="{Binding CannotDisable}">
                                  <TextBlock Text="끌 수 없음" />
                                </Border>
                                <Border Classes="badge warn" IsVisible="{Binding HasExposedPorts}">
                                  <TextBlock Text="{Binding PortBadge}" />
                                </Border>
                                <Border Classes="badge" IsVisible="{Binding IsRunning}">
                                  <TextBlock Text="{Binding MemoryText}" />
                                </Border>
                                <Border Classes="badge" IsVisible="{Binding HasLongCertificate}">
                                  <TextBlock Text="인증서" />
                                </Border>
                                <Border Classes="badge" IsVisible="{Binding IsCurrentlyOff}">
                                  <TextBlock Text="꺼짐" />
                                </Border>
                              </StackPanel>
                              <ComboBox Grid.Column="2" Classes="pill" ItemsSource="{Binding Options}" SelectedItem="{Binding Choice}"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>

      <!-- 상세 -->
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <Border Classes="card" Padding="24,32" Margin="4,48,48,24" VerticalAlignment="Top" IsVisible="{Binding HasSelection}">
          <ContentControl Content="{Binding Selected}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:ProductItemViewModel">
                <StackPanel Spacing="28">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="Bold" LetterSpacing="-0.4" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                      <Border Classes="badge" Classes.warn="{Binding IsRemoveRecommended}"><TextBlock Text="{Binding RecommendationLabel}" FontWeight="Bold" /></Border>
                      <Border Classes="badge ai" IsVisible="{Binding IsAiVerdict}" ToolTip.Tip="규칙에 없는 제품이라 AI가 판정했어요. 적용 전에 확인해 주세요">
                        <TextBlock Text="AI 판정" />
                      </Border>
                      <TextBlock Text="{Binding VendorText}" Classes="muted small" VerticalAlignment="Center" />
                    </StackPanel>
                  </StackPanel>

                  <TextBlock Text="{Binding Reason}" Classes="body" TextWrapping="Wrap" />

                  <StackPanel Spacing="6" IsVisible="{Binding HasRisk}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{StaticResource IconWarning}" Width="15" Height="15" Foreground="{DynamicResource WarnText}" />
                      <TextBlock Text="{Binding RiskTitle}" Classes="danger" FontSize="14" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding RiskLines}" Margin="23,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="muted small" TextWrapping="Wrap" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding HasExposedPorts}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <PathIcon Data="{StaticResource IconWarning}" Width="15" Height="15" Foreground="{DynamicResource WarnText}" />
                      <TextBlock Text="{Binding ExposedPortCount, StringFormat='외부 접속 포트 {0}개'}" Classes="danger" FontSize="14" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Ports}" Margin="23,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="muted small" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel Spacing="8">
                    <ListBox Classes="segment tight" ItemsSource="{Binding Options}" SelectedItem="{Binding Choice}">
                      <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                      </ListBox.ItemsPanel>
                    </ListBox>
                    <TextBlock Text="{Binding Recommended.Label, StringFormat='추천: {0}'}" Classes="muted small" IsVisible="{Binding DiffersFromRecommendation}" />
                  </StackPanel>

                  <Border Background="{DynamicResource WarnBackground}" CornerRadius="16" Padding="20" IsVisible="{Binding CannotDisable}">
                    <StackPanel Spacing="14">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{StaticResource IconLock}" Width="15" Height="15" Foreground="{DynamicResource WarnText}" />
                        <TextBlock Text="끌 수 없음" Classes="danger" FontSize="15" />
                      </StackPanel>
                      <TextBlock Text="관리자도 못 꺼요. 제거만 가능해요." Foreground="{DynamicResource BodyText}" />
                      <Button Classes="accent" Content="제거하기" MinHeight="42" FontSize="14" HorizontalAlignment="Left"
                              Command="{Binding ChooseRemoveCommand}" />
                    </StackPanel>
                  </Border>

                  <!-- 취약점 확인(AI 기능 4): 금융 보안 모듈만 -->
                  <StackPanel Spacing="8" IsVisible="{Binding CanCheckVuln}">
                    <Button Classes="quiet" Content="알려진 취약점 확인" HorizontalAlignment="Left" Command="{Binding CheckVulnCommand}" />
                    <StackPanel Spacing="4" IsVisible="{Binding HasVuln}">
                      <TextBlock Text="{Binding VulnTitle}" FontWeight="Bold" FontSize="13" TextWrapping="Wrap" Classes.danger="{Binding VulnFound}" />
                      <ItemsControl ItemsSource="{Binding VulnLines}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="muted small" TextWrapping="Wrap" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>

                  <!-- 물어보기(AI 기능 5) -->
                  <StackPanel x:Name="AskPanel" Spacing="10" IsVisible="{Binding CanAsk}">
                    <TextBlock Text="물어보기" FontWeight="Bold" FontSize="14" />
                    <ItemsControl ItemsSource="{Binding SampleQuestions}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <Button Classes="quiet" Content="{Binding}" Margin="0,0,6,6" FontSize="12"
                                  Command="{Binding #AskPanel.((vm:ProductItemViewModel)DataContext).UseSampleCommand}" CommandParameter="{Binding}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBox Text="{Binding Question}" Watermark="이 제품에 대해 물어보세요" MinHeight="40" CornerRadius="12" TextWrapping="Wrap" />
                      <Button Grid.Column="1" Classes="accent" Content="묻기" MinHeight="40" Margin="8,0,0,0" Command="{Binding AskCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding AiHint}" IsVisible="{Binding HasAiHint}" Classes="muted small" TextWrapping="Wrap" />
                    <Border Background="{DynamicResource InfoBackground}" CornerRadius="14" Padding="16" IsVisible="{Binding HasAnswer}">
                      <StackPanel Spacing="8">
                        <TextBlock Text="{Binding Answer}" Classes="body" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding AnswerEvidence}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding StringFormat='근거 · {0}'}" Classes="muted small" TextWrapping="Wrap" /></DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </StackPanel>

                  <StackPanel Spacing="6" IsVisible="{Binding HasRuntime}">
                    <ItemsControl ItemsSource="{Binding RuntimeLines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding}" Classes="muted small" TextWrapping="Wrap" /></DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel Spacing="12">
                    <ToggleButton x:Name="ComponentsToggle" Classes="linktoggle" HorizontalAlignment="Left">
                      <TextBlock Text="{Binding ComponentCount, StringFormat='구성 요소 {0}개 보기'}" />
                    </ToggleButton>
                    <StackPanel Spacing="10" IsVisible="{Binding #ComponentsToggle.IsChecked}">
                      <TextBlock Text="{Binding ComponentSummary}" Classes="muted small" TextWrapping="Wrap" />
                      <ItemsControl ItemsSource="{Binding ComponentGroups}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ComponentGroupViewModel">
                            <StackPanel Margin="0,0,0,12" Spacing="6">
                              <TextBlock Text="{Binding Header}" FontWeight="Bold" FontSize="13" />
                              <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate x:DataType="vm:ComponentRowViewModel">
                                    <StackPanel Margin="0,0,0,8" Spacing="1">
                                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                                      <TextBlock Text="{Binding State}" Classes="muted small" />
                                      <TextBlock Text="{Binding Detail}" IsVisible="{Binding HasDetail}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                                    </StackPanel>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Border>
      </ScrollViewer>
    </Grid>

    <!-- 아래 고정 막대 -->
    <Border Grid.Row="1" Background="{DynamicResource BarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="56,20">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <TextBlock Text="{Binding ChangeShort}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" ToolTip.Tip="{Binding ChangeSummary}" />
        <Button Grid.Column="2" Classes="quiet" Content="추천대로" Command="{Binding ResetToRecommendedCommand}" Margin="0,0,12,0" />
        <Button Grid.Column="3" Classes="accent" Content="미리보기 →"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToCommand}" CommandParameter="preview" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
