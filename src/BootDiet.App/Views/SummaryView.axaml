<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BootDiet.App.ViewModels"
             xmlns:c="using:BootDiet.App.Controls"
             x:Class="BootDiet.App.Views.SummaryView"
             x:DataType="vm:SummaryViewModel">
  <!-- S1 요약. 디자인 v05(Main_v05): 제목 한 줄, 큰 숫자 셋, 판정 막대, 부팅 한 줄, 아래 고정 막대. -->
  <UserControl.Styles>
    <Style Selector="Border.seg"><Setter Property="Height" Value="14" /></Style>
    <Style Selector="Border.dot"><Setter Property="Width" Value="10" /><Setter Property="Height" Value="10" /><Setter Property="CornerRadius" Value="3" /></Style>
    <Style Selector="Border.remove"><Setter Property="Background" Value="{DynamicResource VerdictRemove}" /></Style>
    <Style Selector="Border.disable"><Setter Property="Background" Value="{DynamicResource VerdictDisable}" /></Style>
    <Style Selector="Border.banking"><Setter Property="Background" Value="{DynamicResource VerdictBanking}" /></Style>
    <Style Selector="Border.review"><Setter Property="Background" Value="{DynamicResource VerdictReview}" /></Style>
    <Style Selector="Border.keep"><Setter Property="Background" Value="{DynamicResource VerdictKeep}" /></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*,Auto">
    <ScrollViewer>
      <StackPanel Margin="72,64,72,40" Spacing="40" MaxWidth="960" HorizontalAlignment="Left">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Headline}" Classes="h1" FontSize="34" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SubLine}" Classes="muted" FontSize="15" ToolTip.Tip="{Binding ScopeTip}" />
        </StackPanel>

        <!-- 큰 숫자 셋 -->
        <Grid ColumnDefinitions="*,24,*,24,*">
          <Border Classes="card">
            <StackPanel Spacing="16">
              <TextBlock Text="늘 켜진 모듈" Classes="label" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding FinancialRunning}" Classes="big" />
                <TextBlock Text="{Binding FinancialTotal}" Classes="unit" />
              </StackPanel>
              <TextBlock Text="{Binding BeforeRunning}" Classes="muted" IsVisible="{Binding HasBefore}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card" ToolTip.Tip="{Binding ExposedPortsTip}">
            <StackPanel Spacing="16">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconWarning}" Width="15" Height="15" Foreground="{DynamicResource WarnText}" />
                <TextBlock Text="외부 접속 포트" Classes="danger" FontSize="14" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ExposedPorts}" Classes="big" />
                <TextBlock Text="개" Classes="unit" />
              </StackPanel>
              <TextBlock Text="{Binding BeforePorts}" Classes="muted" IsVisible="{Binding HasBefore}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="4" Classes="card" ToolTip.Tip="{Binding MemoryTip}">
            <StackPanel Spacing="16">
              <TextBlock Text="메모리" Classes="label" />
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Memory}" Classes="big" />
                <TextBlock Text="MB" Classes="unit" />
              </StackPanel>
              <TextBlock Text="{Binding BeforeMemory}" Classes="muted" IsVisible="{Binding HasBefore}" />
            </StackPanel>
          </Border>
        </Grid>

        <!-- G3 정리 전·후: 정리 전 스캔이 있을 때만 -->
        <Border Classes="card" IsVisible="{Binding HasChanges}">
          <StackPanel Spacing="20">
            <StackPanel Spacing="6">
              <TextBlock Text="정리 전·후" Classes="h2" />
              <TextBlock Text="{Binding CompareWhen}" Classes="muted small" />
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Changes}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ChangeLine">
                  <Grid ColumnDefinitions="28,260,*" Margin="0,7">
                    <Border Classes="dot" Classes.keep="{Binding IsDone}" Classes.remove="{Binding IsStill}" Classes.review="{Binding IsNew}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Product}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Text}" Foreground="{DynamicResource BodyText}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- 판정 -->
        <Border Classes="card">
          <StackPanel Spacing="22">
            <TextBlock Text="판정" Classes="h2" />
            <Border CornerRadius="999" ClipToBounds="True">
              <ItemsControl ItemsSource="{Binding Verdicts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><c:WeightPanel Gap="4" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:VerdictCount">
                    <Border Classes="seg" Classes.remove="{Binding IsRemove}" Classes.disable="{Binding IsDisable}"
                            Classes.banking="{Binding IsBanking}" Classes.review="{Binding IsReview}" Classes.keep="{Binding IsKeep}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Border>
            <ItemsControl ItemsSource="{Binding Verdicts}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:VerdictCount">
                  <Button Classes="quiet" Padding="0" Margin="0,0,40,0"
                          Command="{Binding $parent[UserControl].((vm:SummaryViewModel)DataContext).Main.GoToCommand}" CommandParameter="products">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Classes="dot" Classes.remove="{Binding IsRemove}" Classes.disable="{Binding IsDisable}"
                              Classes.banking="{Binding IsBanking}" Classes.review="{Binding IsReview}" Classes.keep="{Binding IsKeep}" />
                      <TextBlock Text="{Binding Title}" Foreground="{DynamicResource BodyText}" />
                      <TextBlock Text="{Binding CountText}" FontWeight="Bold" Foreground="{DynamicResource TextBrush}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <StackPanel Spacing="8" IsVisible="{Binding HasAiNote}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Classes="badge ai"><TextBlock Text="AI 판정" /></Border>
            <TextBlock Text="{Binding AiNote}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
        <Button Classes="quiet" Padding="0" IsVisible="{Binding HasRiskNote}" Command="{Binding Main.GoToCommand}" CommandParameter="products">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{StaticResource IconWarning}" Width="16" Height="16" Foreground="{DynamicResource WarnText}" />
            <TextBlock Text="{Binding RiskNote}" Foreground="{DynamicResource BodyText}" />
          </StackPanel>
        </Button>

        <StackPanel Orientation="Horizontal" Spacing="10">
          <PathIcon Data="{StaticResource IconClock}" Width="16" Height="16" Foreground="{DynamicResource MutedText}" />
          <TextBlock Text="{Binding BootLine}" Classes="muted" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Notes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <TextBlock Text="{Binding}" Classes="muted small" TextWrapping="Wrap" Margin="0,2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- 아래 고정 막대: 프리셋(G3) · 고른 개수 · 미리보기 -->
    <Border Grid.Row="1" Background="{DynamicResource BarBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="72,20">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
        <ListBox Classes="segment" ItemsSource="{Binding Products.PresetNames}" SelectedIndex="{Binding Products.PresetIndex}"
                 ToolTip.Tip="쓰임새에 맞춰 한 번에 고르기. AI 추천은 설치된 프로그램과 실행 중인 프로세스로 쓰임새를 추정해요">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
          </ListBox.ItemsPanel>
        </ListBox>
        <TextBlock Grid.Column="1" Text="{Binding Products.PresetNote}" IsVisible="{Binding Products.HasPresetNote}" Classes="muted small"
                   TextWrapping="Wrap" MaxLines="2" VerticalAlignment="Center" Margin="20,0,20,0" />
        <TextBlock Grid.Column="2" Text="{Binding ChangeShort}" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" Margin="0,0,24,0"
                   ToolTip.Tip="{Binding ChangeSummary}" />
        <Button Grid.Column="3" Classes="accent" Content="미리보기 →"
                Command="{Binding Main.GoToCommand}" CommandParameter="preview" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
