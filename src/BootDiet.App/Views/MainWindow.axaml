<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BootDiet.App.ViewModels"
        xmlns:v="using:BootDiet.App.Views"
        x:Class="BootDiet.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="부트다이어트"
        Icon="/Assets/Icon/AppIcon.ico"
        Width="1280" Height="840" MinWidth="1040" MinHeight="640"
        Foreground="{DynamicResource TextBrush}"
        Background="{DynamicResource PageBackground}"
        FontSize="14"
        WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:ScanViewModel"><v:ScanView /></DataTemplate>
    <DataTemplate DataType="vm:SummaryViewModel"><v:SummaryView /></DataTemplate>
    <DataTemplate DataType="vm:ProductListViewModel"><v:ProductsView /></DataTemplate>
    <DataTemplate DataType="vm:PreviewViewModel"><v:PreviewView /></DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel"><v:HistoryView /></DataTemplate>
  </Window.DataTemplates>

  <Grid ColumnDefinitions="232,*">
    <!-- 왼쪽 메뉴: 이름, 메뉴 4개, 아래에 뱅킹 모드 -->
    <Border Background="{DynamicResource NavBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
      <DockPanel Margin="20,40,20,28">
        <TextBlock DockPanel.Dock="Top" Text="부트다이어트" FontSize="19" FontWeight="Bold" LetterSpacing="-0.4" Margin="14,0,0,32" />

        <StackPanel DockPanel.Dock="Bottom" Spacing="12">
          <!-- G4 뱅킹 모드: 평소엔 꺼 둔 금융 모듈을 30분만 켠다 -->
          <Border Background="{DynamicResource BankBackground}" CornerRadius="20" Padding="20" DataContext="{Binding Bank}">
            <StackPanel Spacing="14" x:DataType="vm:BankViewModel">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource IconShield}" Width="16" Height="16" Foreground="{DynamicResource BankText}" />
                <TextBlock Text="뱅킹 모드" FontWeight="Bold" Foreground="{DynamicResource BankText}" />
                <TextBlock Text="켜짐" FontWeight="Bold" Foreground="{DynamicResource BankText}" IsVisible="{Binding IsActive}" />
              </StackPanel>

              <StackPanel Spacing="14" IsVisible="{Binding IsIdle}">
                <TextBlock Text="{Binding ProductsText}" Classes="muted small" />
                <Button Classes="bank" Content="{Binding OnLabel}" Command="{Binding TurnOnCommand}" IsEnabled="{Binding CanTurnOn}"
                        ToolTip.Tip="{Binding OnTip}" ToolTip.ShowOnDisabled="True" />
              </StackPanel>

              <StackPanel Spacing="10" IsVisible="{Binding IsActive}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding RemainingText}" FontSize="30" FontWeight="SemiBold" LetterSpacing="-0.8" Foreground="{DynamicResource TextBrush}" />
                  <TextBlock Text="남음" Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                </StackPanel>
                <ProgressBar Classes="bank" Minimum="0" Maximum="100" Value="{Binding RemainingPercent}" />
                <TextBlock Text="{Binding UntilText}" Classes="muted small" />
                <Button Classes="bank" Content="지금 끄기" Command="{Binding TurnOffCommand}" IsEnabled="{Binding CanTurnOff}" Margin="0,4,0,0" />
              </StackPanel>

              <TextBlock Text="{Binding Message}" Classes="small" Foreground="{DynamicResource WarnText}" TextWrapping="Wrap"
                         IsVisible="{Binding Message, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Border>
          <Button Classes="quiet" Content="다시 스캔" FontSize="13" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Command="{Binding StartScanCommand}" IsEnabled="{Binding !Scan.IsRunning}"
                  ToolTip.Tip="{Binding SourceLabel}" />
        </StackPanel>

        <ListBox Classes="nav" ItemsSource="{Binding Nav}" SelectedItem="{Binding SelectedNav}"
                 IsEnabled="{Binding HasResult}" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:NavItem">
              <StackPanel Orientation="Horizontal" Spacing="12" ToolTip.Tip="{Binding Hint}">
                <PathIcon Data="{Binding IconGeometry}" Width="18" Height="18" />
                <TextBlock Text="{Binding Title}" FontSize="14.5" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- 화면 -->
    <ContentControl Grid.Column="1" Content="{Binding Current}" />
  </Grid>
</Window>
