<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BootDietApp</AssemblyName>
    <RootNamespace>BootDiet.App</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 작품 로고(흰담비) 앱 아이콘 v02 I1 연보라. 탐색기·작업 표시줄의 exe 아이콘 -->
    <ApplicationIcon>Assets\Icon\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pretendard (SIL OFL 1.1, Assets/Fonts/OFL.txt). 어느 PC에서나 같은 글꼴로 보이게 앱에 넣는다. -->
    <AvaloniaResource Include="Assets\Fonts\*.otf" />
    <None Include="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- 창 왼쪽 위·Alt+Tab 아이콘 -->
    <AvaloniaResource Include="Assets\Icon\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BootDiet.Core\BootDiet.Core.csproj" />
    <ProjectReference Include="..\BootDiet.Windows\BootDiet.Windows.csproj" />
    <ProjectReference Include="..\BootDiet.Ai\BootDiet.Ai.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\rules\rules.json" Link="rules\rules.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\samples\*.json" Link="samples\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
