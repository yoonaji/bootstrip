// 부트다이어트 판정 규칙 DB
// - 위에 있는 규칙이 먼저 적용된다. 구체적인 규칙을 일반적인 규칙보다 위에 둘 것.
// - match 안의 조건은 하나라도 맞으면 적용(OR), 대소문자 무시.
// - 같은 규칙에 걸린 구성 요소는 한 제품으로 묶인다. "메신저"처럼 여러 제품에 걸친 분류용 규칙은
//   "perApp": true 로 표시하면 앱(제품명 또는 파일명)마다 따로 묶인다.
// - category: WindowsBuiltIn | HardwareUtility | FinancialSecurity | CorporateSecurity | Game | Updater | GeneralApp
//   (Broken, Suspicious, Unknown은 판정기가 붙이는 값)
// - action:   Keep | Disable | BankingMode | Remove | Review
// - 서비스·드라이버·인증서용 조건: serviceNames, driverNames(와일드카드), certNames(포함)
// - "kinds": ["Driver", "Service"] 처럼 쓰면 그 종류의 구성 요소에만 적용(match와 AND)
{
  "rules": [
    // ───────── Windows 기본 ─────────
    { "id": "win-security-health", "product": "Windows 보안 알림 아이콘", "vendor": "Microsoft",
      "category": "WindowsBuiltIn", "action": "Keep", "reason": "Windows 보안 트레이 아이콘입니다. 가볍고 보안 경고를 보여 줍니다.",
      "match": { "fileNames": ["SecurityHealthSystray.exe"], "nameContains": ["SecurityHealth"] } },
    { "id": "win-copilot", "product": "Microsoft Copilot", "vendor": "Microsoft",
      "category": "GeneralApp", "action": "Disable", "reason": "필요할 때 열면 됩니다. 부팅 시 자동 실행은 필요 없습니다.",
      "match": { "nameContains": ["Copilot"] } },
    { "id": "win-edge-autolaunch", "product": "Microsoft Edge 자동 실행", "vendor": "Microsoft",
      "category": "GeneralApp", "action": "Disable", "reason": "Edge를 미리 띄워 두는 항목입니다. 꺼도 Edge는 정상 동작합니다.",
      "match": { "nameContains": ["MicrosoftEdgeAutoLaunch"] } },
    { "id": "win-onedrive", "product": "OneDrive", "vendor": "Microsoft",
      "category": "GeneralApp", "action": "Keep", "reason": "파일 동기화를 쓴다면 켜 두세요. 쓰지 않으면 꺼도 됩니다.",
      "match": { "fileNames": ["OneDrive.exe"] } },

    // ───────── 국내 금융·인증 보안 모듈 ─────────
    // ───────── 회사 보안·관리 프로그램 (금융 모듈보다 먼저 판정: 회사 PC에서 지우면 안 됨) ─────────
    { "id": "corp-security", "perApp": true, "product": "회사 보안·관리 프로그램", "vendor": "",
      "category": "CorporateSecurity", "action": "Review", "reason": "회사가 설치하는 보안·관리 프로그램(망분리, 문서 보안, 자산 관리)으로 보입니다. 회사 PC라면 그대로 두세요.",
      "match": { "companyContains": ["Hunesion", "Teruten", "YOONDISK", "Fasoo", "SOFTCAMP", "Somansa", "Jiransoft", "Genian", "Ahnlab Policy"], "signerContains": ["Hunesion", "Teruten", "YOONDISK", "Fasoo", "SOFTCAMP", "Somansa", "Genian"], "certNames": ["Teruten", "Hunesion", "YOONDISK"] } },

    { "id": "kr-veraport", "product": "Veraport", "vendor": "위즈베라",
      "category": "FinancialSecurity", "action": "Remove", "reason": "보안 모듈 통합 설치기입니다. 은행 사이트에서 필요할 때 다시 설치됩니다.",
      "match": { "fileNames": ["veraport*.exe"], "nameContains": ["Veraport"], "pathContains": ["\\Wizvera\\Veraport"] } },
    { "id": "kr-delfino", "product": "Delfino", "vendor": "위즈베라",
      "category": "FinancialSecurity", "action": "Remove", "reason": "공동인증서 전자서명 모듈입니다. 인증서 로그인할 때만 필요합니다.",
      "match": { "fileNames": ["delfino*.exe"], "pathContains": ["\\Wizvera\\Delfino"] } },
    { "id": "kr-wizvera", "product": "위즈베라 보안 모듈", "vendor": "위즈베라",
      "category": "FinancialSecurity", "action": "Remove", "reason": "위즈베라 금융 보안 모듈입니다.",
      "match": { "companyContains": ["WIZVERA"], "pathContains": ["\\Wizvera\\"], "certNames": ["WIZVERA", "Veraport", "Delfino"] } },
    { "id": "kr-crossex", "product": "CrossEX", "vendor": "이니라인",
      "category": "FinancialSecurity", "action": "Remove", "reason": "보안 모듈 연동 프로그램입니다. 상시 localhost 포트를 열어 둡니다.",
      "match": { "fileNames": ["CrossEXService.exe", "CrossEX*.exe"], "pathContains": ["\\iniLINE\\"], "companyContains": ["iniLINE"], "certNames": ["CrossEX"] } },
    { "id": "kr-crossweb", "product": "CrossWeb EX", "vendor": "이니텍",
      "category": "FinancialSecurity", "action": "Remove", "reason": "이니텍 전자서명·보안 모듈입니다.",
      "match": { "fileNames": ["CrossWebEX*.exe"], "pathContains": ["\\INITECH\\"], "companyContains": ["INITECH"], "certNames": ["INITECH", "CrossWeb"] } },
    { "id": "kr-certshare", "product": "XecureCertShare (인증서 복사)", "vendor": "한컴위드(소프트포럼)",
      "category": "FinancialSecurity", "action": "Remove", "reason": "PC와 스마트폰 사이에 인증서를 복사하는 모듈입니다. 켜 두면 포트를 열고 기다립니다. 인증서를 옮길 때만 필요합니다.",
      "match": { "fileNames": ["CertShare4PC.exe"], "pathContains": ["\\XecureCertShare\\"] } },
    { "id": "kr-anysign", "product": "AnySign", "vendor": "한컴위드(소프트포럼)",
      "category": "FinancialSecurity", "action": "Remove", "reason": "인증서 전자서명 모듈입니다. 2025~2026년에만 취약점 10건이 신고됐습니다.",
      "match": { "fileNames": ["AnySign4PC.exe"], "pathContains": ["\\SoftForum\\", "\\AnySign"], "companyContains": ["SoftForum", "Hancom WITH", "HancomWITH"], "certNames": ["Hancom Secure", "AnySign", "SoftForum", "XecureWeb"] } },
    { "id": "kr-ipinside", "product": "IPinside", "vendor": "인터리젠",
      "category": "FinancialSecurity", "action": "Remove", "reason": "단말 정보 수집(이상거래 탐지) 모듈입니다. 상시 실행되며 PC 정보를 수집합니다.",
      "match": { "fileNames": ["I3GProc.exe", "I3GSvcManager.exe"], "nameContains": ["ipinside"], "pathContains": ["IPinside"], "companyContains": ["Interezen"], "certNames": ["INTEREZEN"] } },
    { "id": "kr-astx", "product": "AhnLab Safe Transaction", "vendor": "안랩",
      "category": "FinancialSecurity", "action": "Remove", "reason": "금융 거래용 보안 프로그램입니다. 은행 이용 시에만 필요합니다.",
      "match": { "fileNames": ["stsess.exe", "astx*.exe"], "nameContains": ["AhnLab Safe Transaction"], "pathContains": ["\\AhnLab\\Safe Transaction"], "certNames": ["ASTxRoot", "AhnLab Safe Transaction"] } },
    { "id": "kr-nprotect", "product": "nProtect Online Security", "vendor": "잉카인터넷",
      "category": "FinancialSecurity", "action": "Remove", "reason": "금융 사이트용 키보드·온라인 보안 프로그램입니다.",
      "match": { "pathContains": ["\\nProtect\\", "\\INCAInternet"], "companyContains": ["INCA Internet"], "certNames": ["INCA Internet", "INCA G", "nProtect"] } },
    { "id": "kr-touchen", "product": "TouchEn nxKey", "vendor": "라온시큐어",
      "category": "FinancialSecurity", "action": "Remove", "reason": "키보드 보안 모듈입니다. KAIST 연구에서 키 입력 가로채기에 악용 가능한 구조가 지적됐습니다.",
      "match": { "nameContains": ["TouchEn"], "pathContains": ["\\RaonSecure\\", "\\TouchEn"], "companyContains": ["RaonSecure"], "certNames": ["TouchEn", "RaonSecure", "RAON SECURE"] } },
    { "id": "kr-magicline", "product": "MagicLine", "vendor": "드림시큐리티",
      "category": "FinancialSecurity", "action": "Remove", "reason": "인증서 전자서명 모듈입니다.",
      "match": { "fileNames": ["MagicLine*.exe", "SmartCert.exe"], "pathContains": ["\\DreamSecurity\\"], "companyContains": ["드림시큐리티", "DreamSecurity"], "certNames": ["MagicLine", "DreamSecurity"] } },
    { "id": "kr-nxts", "product": "SCORE PKI (nxTS)", "vendor": "한국무역정보통신(KTNET)",
      "category": "FinancialSecurity", "action": "Remove", "reason": "KTNET 인증서 모듈입니다.",
      "match": { "fileNames": ["nxTS.exe"], "pathContains": ["\\nxTS\\"], "companyContains": ["Korea Trade Network"], "certNames": ["KTNET"] } },
    { "id": "kr-signkorea", "product": "SignKorea", "vendor": "코스콤",
      "category": "FinancialSecurity", "action": "Remove", "reason": "코스콤 인증서 서비스입니다.",
      "match": { "fileNames": ["SKCertService.exe"], "pathContains": ["\\SignKorea\\"], "certNames": ["SignKorea"] } },
    { "id": "kr-kica", "product": "KICA 인증 모듈", "vendor": "한국정보인증",
      "category": "FinancialSecurity", "action": "Remove", "reason": "한국정보인증 인증서 모듈입니다.",
      "match": { "fileNames": ["kpmcnt.exe"], "pathContains": ["\\KICA\\"], "certNames": ["KICA"] } },
    { "id": "kr-yettiesoft", "product": "YettieSoft APS", "vendor": "예티소프트",
      "category": "FinancialSecurity", "action": "Remove", "reason": "예티소프트 보안 엔진입니다.",
      "match": { "fileNames": ["pennyroyal.exe"], "pathContains": ["\\yettiesoft\\"] } },
    { "id": "kr-crosscert", "product": "UniSign", "vendor": "한국전자인증",
      "category": "FinancialSecurity", "action": "Remove", "reason": "한국전자인증 인증서 모듈입니다.",
      "match": { "nameContains": ["UniSign"], "pathContains": ["\\CrossCert\\", "\\UniSign"] } },
    { "id": "kr-ksign", "product": "KSign", "vendor": "케이사인",
      "category": "FinancialSecurity", "action": "Remove", "reason": "케이사인 인증 모듈입니다.",
      "match": { "pathContains": ["\\KSign\\"] } },
    { "id": "kr-vestcert", "product": "VestCert", "vendor": "",
      "category": "FinancialSecurity", "action": "Remove", "reason": "공동인증서 관리 모듈입니다.",
      "match": { "fileNames": ["VestCert*.exe"], "pathContains": ["\\VestCert"] } },
    { "id": "kr-secukit", "product": "SecuKit NX", "vendor": "",
      "category": "FinancialSecurity", "action": "Remove", "reason": "인증 보안 모듈입니다.",
      "match": { "pathContains": ["SecuKit"] } },
    { "id": "kr-epagesafer", "product": "ePageSafer", "vendor": "마크애니",
      "category": "FinancialSecurity", "action": "Remove", "reason": "공공·금융 문서 출력 보안 모듈입니다.",
      "match": { "nameContains": ["ePageSafer"], "pathContains": ["\\MarkAny\\", "ePageSafer"] } },
    { "id": "kr-reportx", "product": "ReportX 증명서 출력", "vendor": "디지털존",
      "category": "FinancialSecurity", "action": "Remove", "reason": "인터넷 증명서 발급 사이트의 출력 모듈입니다. 증명서를 뽑을 때 사이트에서 다시 설치됩니다.",
      "match": { "fileNames": ["REPORTXSvc.exe"], "pathContains": ["\\REPORTX\\", "\\certpia\\"], "companyContains": ["DIGITALZONE"], "certNames": ["DigitalZone"] } },
    { "id": "kr-ahnlab-mkd", "product": "MyKeyDefense (키보드 보안)", "vendor": "안랩",
      "category": "FinancialSecurity", "action": "Remove", "reason": "금융 사이트용 키보드 보안 드라이버입니다. 커널 드라이버라 늘 설치되어 있습니다.",
      "match": { "driverNames": ["Mkd*"], "pathContains": ["MyKeyDefense"] } },
    { "id": "kr-ahnlab-securebrowser", "product": "AhnLab SecureBrowser", "vendor": "안랩",
      "category": "FinancialSecurity", "action": "Remove", "reason": "금융 사이트용 보안 브라우저 드라이버입니다.",
      "match": { "driverNames": ["HSBDrv*"] } },
    { "id": "kr-kings", "product": "K-Defense / KOS", "vendor": "킹스정보통신",
      "category": "FinancialSecurity", "action": "Remove", "reason": "킹스정보통신의 키보드·온라인 보안 모듈입니다. 커널 드라이버와 서비스가 늘 떠 있습니다.",
      "match": { "companyContains": ["Kings Information"], "signerContains": ["Kings Information"], "pathContains": ["\\Kings Online Security\\"], "certNames": ["Kings Information"] } },
    { "id": "kr-imagesafer", "product": "Image SAFER (화면 캡처 방지)", "vendor": "마크애니",
      "category": "FinancialSecurity", "action": "Remove", "reason": "증명서·금융 사이트가 설치하는 화면 캡처 방지 모듈입니다. 회사가 설치한 것이면 지우지 마세요.",
      "match": { "fileNames": ["IMGSF*Svc.exe", "ImageSAFERDrv*.sys"], "nameContains": ["IMGSF"] } },
    { "id": "kr-raonk", "product": "RAON K (파일 전송)", "vendor": "라온위즈",
      "category": "FinancialSecurity", "action": "Remove", "reason": "웹사이트 대용량 파일 올리기·내려받기 모듈입니다. 해당 사이트에서 필요할 때 다시 설치됩니다.",
      "match": { "companyContains": ["RAONWIZ"], "signerContains": ["RAONWIZ"], "pathContains": ["\\RAONWIZ\\"], "certNames": ["RAON K"] } },
    { "id": "kr-vpwallet", "product": "VP 결제 모듈(ISP/페이북)", "vendor": "브이피",
      "category": "FinancialSecurity", "action": "Remove", "reason": "카드 결제용 모듈입니다. 결제할 때만 필요합니다.",
      "match": { "nameContains": ["VPWallet"], "companyContains": ["VP Inc."], "certNames": ["VP ROOT"] } },

    // ───────── 공인 인증기관 루트 인증서 (일부 프로그램이 함께 넣어 두는 것) ─────────
    { "id": "win-public-root", "perApp": true, "kinds": ["RootCertificate"], "product": "공인 인증기관 루트 인증서", "vendor": "",
      "category": "WindowsBuiltIn", "action": "Keep", "reason": "널리 쓰이는 공인 인증기관의 루트 인증서입니다. 지우면 일부 사이트·프로그램 서명 확인이 실패할 수 있습니다.",
      "match": { "certNames": ["DigiCert", "GlobalSign", "Sectigo", "COMODO", "USERTrust", "Baltimore", "VeriSign", "thawte", "Thawte", "Entrust", "ISRG", "Go Daddy", "GoDaddy", "Starfield", "Amazon Root", "GTS Root", "Google Trust", "QuoVadis", "Certum", "IdenTrust", "SECOM", "Symantec", "GeoTrust", "AAA Certificate Services", "SSL.com", "Actalis", "Buypass", "T-TeleSec", "Class 3 Public Primary", "Starfield", "Hotspot 2.0 Trust Root", "KISA RootCA"] } },

    // ───────── 제조사·드라이버 유틸 (구체적인 끄기 대상 먼저) ─────────
    { "id": "hw-csr-hcrp", "product": "CSR 블루투스 프린터 서버", "vendor": "CSR",
      "category": "HardwareUtility", "action": "Disable", "reason": "블루투스 프린터(HCRP)용입니다. 거의 쓰지 않습니다.",
      "match": { "fileNames": ["CsrHCRPServer.exe"] } },
    { "id": "hw-csr-syncml", "product": "CSR 휴대폰 동기화", "vendor": "CSR",
      "category": "HardwareUtility", "action": "Disable", "reason": "옛 휴대폰 주소록 동기화(SyncML) 기능입니다.",
      "match": { "fileNames": ["CsrSyncMLServer.exe"] } },
    { "id": "hw-csr-skype", "product": "CSR Skype 플러그인", "vendor": "CSR",
      "category": "HardwareUtility", "action": "Disable", "reason": "종료된 Skype 연동 플러그인입니다.",
      "match": { "fileNames": ["CSRHarmonySkypePlugin*.exe"], "nameContains": ["SkypePlugin"] } },
    { "id": "hw-csr-bluetooth", "product": "CSR Harmony 블루투스", "vendor": "CSR",
      "category": "HardwareUtility", "action": "Keep", "reason": "블루투스 스택 본체입니다. 블루투스를 쓴다면 켜 두세요.",
      "match": { "fileNames": ["vksts.exe", "HarmonyUserStartup.exe", "CsrAudioguiCtrl.exe"], "nameContains": ["Csr Bluetooth"], "pathContains": ["\\CSR Harmony"], "companyContains": ["Cambridge Silicon Radio"] } },
    { "id": "hw-lg", "product": "LG 노트북 유틸", "vendor": "LG전자",
      "category": "HardwareUtility", "action": "Keep", "reason": "Fn키·배터리 관리 등 노트북 기능에 필요합니다.",
      "match": { "fileNames": ["LGControlCenter*.exe", "HotkeyManager.exe"], "pathContains": ["\\LG Software\\"] } },
    { "id": "hw-asus", "product": "ASUS 유틸", "vendor": "ASUS",
      "category": "HardwareUtility", "action": "Keep", "reason": "제조사 하드웨어 제어 유틸입니다. 쓰지 않는 기능만 골라 끄세요.",
      "match": { "companyContains": ["ASUSTeK"], "pathContains": ["\\Program Files\\ASUS\\", "\\Program Files (x86)\\ASUS\\"] } },
    { "id": "hw-km-ftp", "product": "코니카미놀타 FTP 유틸리티", "vendor": "코니카미놀타",
      "category": "HardwareUtility", "action": "Disable", "reason": "복합기에서 스캔한 파일을 받는 FTP 서버입니다. 켜 두면 FTP 포트가 계속 열려 있습니다. 스캔을 받을 때만 실행하세요.",
      "match": { "fileNames": ["KMFtp.exe"] } },
    { "id": "hw-driver-vendor", "perApp": true, "kinds": ["Driver", "Service"], "product": "하드웨어 드라이버", "vendor": "",
      "category": "HardwareUtility", "action": "Keep", "reason": "장치 드라이버나 그 서비스입니다. 끄면 해당 장치가 동작하지 않을 수 있습니다.",
      "match": { "companyContains": ["Intel", "Realtek", "NVIDIA", "Advanced Micro Devices", "AMD", "Synaptics", "ELAN", "Qualcomm", "MediaTek", "Broadcom", "Marvell", "Conexant", "Cirrus Logic", "Dolby", "Waves", "Alps", "Cypress", "Genesys", "Prolific", "Silicon Labs", "FTDI", "Future Technology Devices", "Logitech", "Lenovo", "Dell", "HP Inc", "Hewlett", "Samsung Electronics", "Cambridge Silicon Radio", "LG Electronics", "ASIX"], "signerContains": ["Intel Corporation", "LG Electronics", "Realtek", "Advanced Micro Devices", "NVIDIA", "Synaptics", "Conexant"] } },
    { "id": "hw-audio", "perApp": true, "product": "오디오 드라이버 유틸", "vendor": "",
      "category": "HardwareUtility", "action": "Keep", "reason": "오디오 드라이버 보조 프로그램입니다. 끄면 소리·잭 감지가 이상해질 수 있습니다.",
      "match": { "fileNames": ["CAudioFilterAgent*.exe", "RtkAudUService*.exe", "RAVBg64.exe", "WavesSvc*.exe"], "companyContains": ["Realtek", "Conexant", "Waves Audio"] } },
    { "id": "hw-input", "perApp": true, "product": "입력장치 유틸", "vendor": "",
      "category": "HardwareUtility", "action": "Keep", "reason": "마우스·키보드·터치패드 설정에 필요합니다.",
      "match": { "fileNames": ["lghub*.exe"], "companyContains": ["Logitech", "Synaptics", "ELAN Microelectronic", "Razer"] } },
    { "id": "hw-gpu", "perApp": true, "product": "그래픽 드라이버 유틸", "vendor": "",
      "category": "HardwareUtility", "action": "Keep", "reason": "그래픽 드라이버 구성 요소입니다.",
